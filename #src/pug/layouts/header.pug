.header
	._container
		._content
			a(href="@@webRoot/index.html" alt="image")._column.el-logo.transform-perspective
				._logo-wrpper.transform-box
					._logo
						img(src="@@webRoot/img/header/logo.png")
					._text
						span Александр Васильев
			._column.el-community
				ul._menu
					li._item
						a(href="@@webRoot/index.html")
							i.icon-home
					li._item
						a(href="@@webRoot/services.html" data-letters="Проекты")._link-key
							| Проекты 
					li._item
						a(href="@@webRoot/about.html" data-letters="Обо мне")._link-key
							| Обо мне 
					li._item
						a(href="#contacts" data-letters="Контакты")._link-key.anchor-link 
							| Контакты
				a.el-community__phone(href="mailto:awdes@yandex.ru")
					+iconfont('contacts', '_icon')
					.el-community__content 
						span.el-community__title Скажи привет! 